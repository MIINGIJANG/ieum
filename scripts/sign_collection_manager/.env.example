OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# USD per 1M tokens. Leave blank to omit cost estimates.
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=

# Optional local storage paths.
# KSL_DATA_DIR=data
# KSL_DB=data/signs.sqlite3

# JSON array of coordinate directories, e.g. ["C:/datasets/signs"].
KSL_SOURCE_ROOTS=[]
